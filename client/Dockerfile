# ============================================================
# 1단계: 빌드 스테이지
# ------------------------------------------------------------
# 목적: "npm run build"를 실행해서 dist/ 폴더(정적 파일)를 만드는 것.
# 여기서 만든 dist/ 말고는 아무것도 최종 이미지에 남지 않습니다.
# (node, npm, node_modules, 소스코드 전부 이 단계에서만 쓰이고 버려짐)
# ============================================================
FROM node:22-alpine AS build

WORKDIR /app

# package.json만 먼저 복사해서 npm ci를 실행합니다.
# (소스코드 전체를 아직 안 넣는 이유: 소스코드만 바뀌고 package.json이
#  안 바뀌면, Docker가 이 npm ci 결과를 캐시로 재사용해서 훨씬 빨라집니다)
COPY package*.json ./
RUN npm ci

# 이제 나머지 소스코드 전체 복사 (client/.env 포함)
COPY . .

# VITE_* 환경변수(.env)는 여기, 빌드하는 이 순간에 결과물(JS 파일)
# 안에 그대로 박혀 들어갑니다. 나중에 컨테이너를 실행할 때 -e 로
# 넘겨줘도 이미 늦음 — 그래서 서버(server)와 달리 client는 .env를
# .dockerignore로 빼면 안 됩니다.
RUN npm run build

# ============================================================
# 2단계: 서빙(serving) 스테이지 — 진짜 최종 이미지는 이것뿐
# ------------------------------------------------------------
# 목적: 위에서 만든 dist/ 안의 정적 파일(html/css/js)을 nginx로 서빙.
# node나 소스코드는 필요 없으니 훨씬 가볍고 안전한 nginx 이미지로 시작.
# ============================================================
FROM nginx:alpine

# 1단계(build) 스테이지의 /app/dist 폴더만 쏙 가져와서 nginx가
# 정적 파일을 서빙하는 기본 경로에 넣습니다.
COPY --from=build /app/dist /usr/share/nginx/html

# nginx는 컨테이너 "내부"에서 항상 80번 포트로 서비스합니다
# (vite dev 서버 포트인 5000/5173 등과는 전혀 무관합니다).
# 실행할 때 원하는 "호스트" 포트를 80번에 매핑하세요:
#   docker run -p 5173:80 <image>   → 호스트 5173 접속 시 컨테이너 80으로 연결
EXPOSE 80
