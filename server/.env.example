PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=claude_study

# 클라이언트 개발 서버 주소 (CORS 허용 origin, 여러 개는 쉼표로 구분)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# access token 수명(초), refresh token 수명(ms)
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_MS=604800000
